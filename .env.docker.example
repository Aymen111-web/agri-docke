# ==============================================================================
# B2B Agri-Tech Marketplace - Docker Environment Configuration
# Copy this file to .env before starting containers:
#   cp .env.docker.example .env
# ==============================================================================

# --- Application Configuration ---
APP_NAME="B2B Agri Tech Marketplace"
APP_ENV=local
APP_KEY=base64:oG8iYy5iGg1ZqN6pT4L8vW9rQ2eX0mY7uI3oP5sA1bC=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# --- Frontend Configuration ---
VITE_API_BASE_URL=/api

# --- MySQL Database Configuration ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=b2b_agri_tech
DB_USERNAME=agri_user
DB_PASSWORD=agri_secret
DB_ROOT_PASSWORD=root_secret

# --- Laravel Internals ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# --- Database Startup Hooks ---
AUTORUN_MIGRATIONS=true
AUTORUN_SEEDERS=false

# --- Chapa Payment Gateway ---
CHAPA_SECRET_KEY=CHASECK_TEST-placeholder
CHAPA_WEBHOOK_SECRET=placeholder_secret
CHAPA_CALLBACK_URL=http://localhost:8080/api/payments/webhook
CHAPA_RETURN_URL=http://localhost:8080/payment/success

# --- SMS Ethiopia Service ---
SMS_ETHIOPIA_API_KEY=
SMS_ETHIOPIA_BASE_URL=https://smsethiopia.et/api

